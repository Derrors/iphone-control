# 复制为 .env 后按需修改。所有项都可以留空，用默认值。.env 里有通知密钥，不要提交到 git。

# 容器名。改了的话，`iphone-control mcp-config --container <新名字>` 打印的注册命令和 README 里的 docker exec 都要跟着换
CONTAINER_NAME=iphone-control
# 镜像名（compose 构建出的本地镜像，或要拉取的发布镜像）
IMAGE=iphone-control:local
# 数据目录：配对记录、Apple ID 会话和开发私钥、签好的 WDA、开发者镜像缓存、日志、锁屏密码。务必备份，不要提交
DATA_DIR=./data

# 接了多台手机时指定要控制的那台；留空用第一台
IPHONE_UDID=
# WDA 从没连上过、又要走 HID 后备路线时换算坐标用的屏幕尺寸（点）；一般留空
SCREEN_W=
SCREEN_H=

# 代理：下载开发者镜像、Apple ID 登录、构建镜像、发 Telegram 都会用；留空表示直连
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# 描述文件（免费账号 7 天有效）剩余不到几天时重签；每隔几小时检查一次
RESIGN_MIN_DAYS=2
RESIGN_CHECK_HOURS=6
# 手机离线超过几分钟推送提醒；0 表示不提醒
OFFLINE_ALERT_MIN=10

# 通知：配了哪个就发哪个。触发场景：重签失败、Apple ID 会话失效、手机离线/恢复、重启后需要输密码、自动解锁失败
TG_BOT_TOKEN=
TG_CHAT_ID=
BARK_SERVER=https://api.day.app
BARK_KEY=

# 高级
# 自建 anisette 服务（默认用 Impactor 的第三方服务）
ICTL_ANISETTE_URL=
# 开发者镜像下载地址（默认社区维护的 doronz88/DeveloperDiskImage）；或指向自己从 Xcode 提取的目录
ICTL_DDI_URL=
ICTL_DDI_DIR=
# 宿主机已经在跑 usbmuxd 服务时设为 0，守护进程就不自己拉起
ICTL_MANAGE_USBMUXD=1
# 日志级别（tracing EnvFilter 语法）
# ICTL_LOG=info,ictl_wda::http=debug
