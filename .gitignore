/target
**/*.rs.bk
# 测试进程崩溃（如栈溢出）留下的 core dump，落在各个包的根目录；几十上百 MB，还可能含内存里的数据
/crates/*/core
/apps/*/core
core.[0-9]*
# 运行时数据和秘密，永远不进仓库
/data/
/secrets/
*.p12
*.mobileprovision
*.pem
*.ipa
.env
# tests/device/run.py 的虚拟环境和真机截图（截图里可能有个人信息）
.venv/
shots/
THIRD_PARTY_LICENSES.html

# Python release tooling
/packaging/__pycache__/
/tests/device/__pycache__/
